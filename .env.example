# QuikInvoice Root Environment Configuration Template
# QuikInvoice backend reads its configuration from server/.env
# Copy this file or server/.env.example to server/.env:
#   cp server/.env.example server/.env

# Server Runtime Configuration
PORT=5001
NODE_ENV=development

# MySQL Database Configuration (Development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=quikinvoice_dev

# MySQL Database Configuration (Automated Testing)
DB_NAME_TEST=quikinvoice_test

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h
COOKIE_SECRET=replace_with_a_secure_cookie_signature_secret

# CORS & Client Application
CORS_ORIGIN=http://localhost:5173
